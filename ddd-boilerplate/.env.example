# Task Master AI Configuration
# ============================================
# Copy this file to .env and fill in your API keys
# At least one AI provider key is required for Task Master
# ============================================

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=

# Perplexity API Key (recommended for research features)
PERPLEXITY_API_KEY=

# Google API Key (for Gemini models)
GOOGLE_API_KEY=

# xAI API Key (for Grok models)
XAI_API_KEY=

# OpenRouter API Key (for multiple model providers)
OPENROUTER_API_KEY=
