{
  "name": "ddd-boilerplate",
  "version": "1.0.0",
  "description": "Domain-Driven Design and Clean Architecture boilerplate for TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "validate:architecture": "node scripts/validate-architecture.js",
    "validate:layers": "node scripts/validate-architecture.js",
    "clean": "rimraf dist",
    "test:claude-flow": "jest --selectProjects claude-flow-integration",
    "ubiquitous-language:extract": "node scripts/extract-ubiquitous-language.js",
    "performance:report": "node scripts/performance-report.js",
    "performance:dashboard": "node scripts/performance-report.js --format html --output dashboard.html && open dashboard.html",
    "task:init": "npx task-master init",
    "task:parse": "npx task-master parse-prd .taskmaster/docs/prd.txt",
    "task:list": "npx task-master list",
    "task:next": "npx task-master next",
    "task:show": "npx task-master show",
    "task:complexity": "npx task-master complexity-report",
    "task:expand": "npx task-master expand"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "typescript",
    "hexagonal-architecture"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "agentdb": "^1.3.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "claude-flow": "^2.7.0-alpha.10",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
